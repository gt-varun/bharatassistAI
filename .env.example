# Root environment variables blueprint (Placeholder values only - never commit real secrets)
# Production values are configured in Vercel and Render dashboards

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bharatassist?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173
