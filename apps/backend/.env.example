PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bharatassist?retryWrites=true&w=majority
JWT_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
GEMINI_API_KEY=your_gemini_api_key
# Chat completions run on Groq when this is set (falls back to Gemini, then
# an offline placeholder response, if absent). Gemini is still used for
# embeddings regardless — Groq has no embeddings endpoint.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
FRONTEND_URL=http://localhost:5173

# Translation service — pick one provider (see docs/translation.md).
# Leave unset to auto-detect in this order: bhashini, groq, gemini, indictrans.
TRANSLATION_PROVIDER=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# TRANSLATION_PROVIDER=groq reuses GROQ_API_KEY above
# TRANSLATION_PROVIDER=gemini reuses GEMINI_API_KEY above
# TRANSLATION_PROVIDER=indictrans
INDICTRANS_URL=http://localhost:8000
